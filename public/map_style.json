{
  "version": 8,
  "name": "Grayscale with Transit",
  "metadata": {},
  "bearing": 0,
  "pitch": 45,
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://api.maptiler.com/tiles/v3/tiles.json?key=get_your_own_OpIi9ZULNHzrESv6T2vL"
    }
  },
  "sprite": "",
  "glyphs": "https://routing.storage.hekinav.dev/font-pbf/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {"background-color": "#f7f7f7"}
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {"fill-color": "#bfe6b5", "fill-opacity": 0.6}
    },
    {
      "id": "landcover-grass",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "grass"],
      "paint": {"fill-color": "#d3edc9", "fill-opacity": 0.6}
    },
    {
      "id": "landuse-residential",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landuse",
      "filter": ["==", "class", "residential"],
      "paint": {"fill-color": "#e4d3b8", "fill-opacity": 0.4}
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {"fill-color": "#a8d9a0", "fill-opacity": 0.6}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {"fill-color": "#a8c4f0"}
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {"line-color": "#8fb3ea", "line-width": 1}
    },
    {
      "id": "road-path",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "path"],
      "paint": {
        "line-color": "#dddddd",
        "line-width": 0.75,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track"],
      "paint": {
        "line-color": "#e2e2e2",
        "line-width": {"base": 1.2, "stops": [[13, 0.5], [16, 2]]}
      }
    },
    {
      "id": "road-secondary-tertiary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "secondary", "tertiary"],
      "paint": {
        "line-color": "#d4d4d4",
        "line-width": {"base": 1.2, "stops": [[10, 1], [16, 4]]}
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["==", "class", "primary"],
      "paint": {
        "line-color": "#c6c6c6",
        "line-width": {"base": 1.2, "stops": [[7, 1], [16, 6]]}
      }
    },
    {
      "id": "road-trunk-motorway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": {
        "line-color": "#d8b93a",
        "line-width": {"base": 1.2, "stops": [[5, 1.2], [16, 9]]},
        "line-opacity": 0.5
      }
    },
    {
      "id": "road-trunk-motorway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "filter": ["in", "class", "trunk", "motorway"],
      "paint": {
        "line-color": "#f5e79a",
        "line-width": {"base": 1.2, "stops": [[5, 0.8], [16, 7]]}
      }
    },
    {
      "id": "transit-rail-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["==", ["get", "class"], "rail"],
        ["in", ["get", "subclass"], ["literal", ["rail", "narrow_gauge"]]]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {"base": 1.2, "stops": [[6, 1.5], [16, 4]]},
        "line-opacity": 0.7
      }
    },
    {
      "id": "transit-rail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 6,
      "filter": [
        "all",
        ["==", ["get", "class"], "rail"],
        ["in", ["get", "subclass"], ["literal", ["rail", "narrow_gauge"]]]
      ],
      "paint": {
        "line-color": "#b5b5b5",
        "line-width": {"base": 1.2, "stops": [[6, 0.7], [16, 2.2]]},
        "line-opacity": 0.95
      }
    },
    {
      "id": "transit-subway-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "class"], "transit"],
        ["==", ["get", "subclass"], "subway"]
      ],
      "paint": {
        "line-color": "#ffffff",
        "line-width": {"base": 1.2, "stops": [[8, 1.5], [16, 4]]},
        "line-opacity": 0.7
      }
    },
    {
      "id": "transit-subway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "class"], "transit"],
        ["==", ["get", "subclass"], "subway"]
      ],
      "paint": {
        "line-color": "#b5b5b5",
        "line-width": {"base": 1.2, "stops": [[8, 0.7], [16, 2.2]]},
        "line-opacity": 0.95
      }
    },
    {
      "id": "transit-tram-lightrail-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "all",
        ["==", ["get", "class"], "transit"],
        ["in", ["get", "subclass"], ["literal", ["tram", "light_rail"]]]
      ],
      "paint": {"line-color": "#ffffff", "line-width": 2.4, "line-opacity": 0.7}
    },
    {
      "id": "transit-tram-lightrail",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 8,
      "filter": [
        "all",
        ["==", ["get", "class"], "transit"],
        ["in", ["get", "subclass"], ["literal", ["tram", "light_rail"]]]
      ],
      "paint": {
        "line-color": "#b5b5b5",
        "line-width": {"base": 1.2, "stops": [[9, 0.7], [16, 2]]},
        "line-opacity": 0.95
      }
    },
    {
      "id": "transit-ferry",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 10,
      "filter": ["==", "class", "ferry"],
      "paint": {
        "line-color": "rgba(108, 137, 188, 1)",
        "line-width": 1,
        "line-opacity": 0.6,
        "line-dasharray": [1, 2]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 4],
      "paint": {
        "line-color": "#bbbbbb",
        "line-width": 0.75,
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["==", "admin_level", 2],
      "paint": {"line-color": "#999999", "line-width": 1.2}
    },
    {
      "id": "building",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 13,
      "maxzoom": 15,
      "paint": {
        "fill-color": "#dcdcdc",
        "fill-outline-color": "#d0d0d0",
        "fill-opacity": 0.8
      }
    },
    {
      "id": "building-3d",
      "type": "fill-extrusion",
      "source": "openmaptiles",
      "source-layer": "building",
      "minzoom": 15,
      "paint": {
        "fill-extrusion-color": "#d6d6d6",
        "fill-extrusion-height": [
          "coalesce",
          ["get", "render_height"],
          ["*", ["coalesce", ["get", "levels"], 1], 3]
        ],
        "fill-extrusion-base": ["coalesce", ["get", "render_min_height"], 0],
        "fill-extrusion-opacity": 0.85
      }
    },
    {
      "id": "road-label-motorway",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 9,
      "filter": ["in", "class", "motorway", "trunk"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Host Grotesk"],
        "text-size": 12.5,
        "text-letter-spacing": 0.03,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#5a5a5a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "road-label-primary",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 11,
      "filter": ["==", "class", "primary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Host Grotesk"],
        "text-size": 12,
        "text-letter-spacing": 0.02
      },
      "paint": {
        "text-color": "#5a5a5a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "road-label-secondary",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": ["in", "class", "secondary", "tertiary"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 10.5
      },
      "paint": {
        "text-color": "#7a7a7a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "road-label-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 15,
      "filter": ["in", "class", "minor", "service"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 9.5
      },
      "paint": {
        "text-color": "#8a8a8a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "transit-rail-label",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "transportation_name",
      "minzoom": 12,
      "filter": ["==", "class", "rail"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 10
      },
      "paint": {
        "text-color": "#8a8a8a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-country-major",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "country"], ["<=", ["get", "rank"], 3]],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 18,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.08
      },
      "paint": {
        "text-color": "#3d3d3d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-country-minor",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["all", ["==", ["get", "class"], "country"], [">", ["get", "rank"], 3]],
      "minzoom": 3,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 13,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.06
      },
      "paint": {
        "text-color": "#5a5a5a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-state",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "state"],
      "minzoom": 4,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 11,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.04
      },
      "paint": {
        "text-color": "#7a7a7a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "city"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          ["case", ["==", ["get", "capital"], 2], 13, 10],
          10,
          ["case", ["==", ["get", "capital"], 2], 17, 15]
        ]
      },
      "paint": {
        "text-color": "#3d3d3d",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "place-town-village",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 8,
      "filter": ["in", "class", "town", "village"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 8, 10, 14, 13]
      },
      "paint": {
        "text-color": "#666666",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      }
    },
    {
      "id": "place-suburb-neighbourhood",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 13,
      "filter": ["in", "class", "suburb", "neighbourhood", "quarter"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Host Grotesk"],
        "text-size": 10,
        "text-transform": "uppercase",
        "text-letter-spacing": 0.03
      },
      "paint": {
        "text-color": "#8a8a8a",
        "text-halo-color": "#ffffff",
        "text-halo-width": 0.8
      }
    }
  ]
}